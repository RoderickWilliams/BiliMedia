{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": false,
    "outDir": "./.ts-cache",
    "rootDir": ".",
    "types": ["node"]
  },
  "include": ["api/**/*", "lib/**/*"],
  "exclude": ["node_modules", "bilimedia-frontend", "bilimedia-backend"]
}
