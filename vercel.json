{
  "version": 2,
  "buildCommand": "cd bilimedia-frontend && npm install && npm run build",
  "outputDirectory": "bilimedia-frontend/dist",
  "installCommand": "npm install",
  "functions": {
    "api/**/*.ts": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/api/parse", "destination": "/api/parse" },
    { "source": "/api/recognize", "destination": "/api/recognize" },
    { "source": "/api/download/video", "destination": "/api/download/video" },
    { "source": "/api/download/music", "destination": "/api/download/music" },
    { "source": "/((?!api).*)", "destination": "/index.html" }
  ]
}
